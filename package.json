{
  "name": "data-quality",
  "version": "0.0.0",
  "private": true,
  "description": "CLI tool — review report SQL against requirement docs via LLM",
  "type": "module",
  "bin": {
    "report-sql-review": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
