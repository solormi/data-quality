# =============================================================================
# LLM Provider Configuration Template
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real key in .env  (NEVER commit .env — see .gitignore)
#   3. CLI / Web UI auto-loads .env via dotenv
#
# ⚠️  SECURITY:
#   - .env is git-ignored. ONLY .env.example should be in version control.
#   - secret-scan.test.ts will fail the test suite if a real key is committed.
#   - Do NOT share screenshots / logs that include .env contents.
#
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Your LLM API key
# -----------------------------------------------------------------------------
# Get one from your provider's console:
#   - MiniMax (international): https://platform.minimax.io
#   - MiniMax (China):         https://platform.minimaxi.com
#   - OpenAI:                   https://platform.openai.com
#   - Any other OpenAI-compatible service
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL: Provider endpoint
# -----------------------------------------------------------------------------
# Default if unset: https://api.openai.com/v1
# Uncomment ONE of the lines below, or set your own.

# --- MiniMax (international, M3) ---
# OPENAI_BASE_URL=https://api.minimax.io/v1
# OPENAI_MODEL=MiniMax-M3

# --- MiniMax (China) ---
# OPENAI_BASE_URL=https://api.minimaxi.com/v1
# OPENAI_MODEL=MiniMax-M3

# --- OpenAI ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Local Ollama (no key required, leave OPENAI_API_KEY blank) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3

# -----------------------------------------------------------------------------
# OPTIONAL: Request timeout (milliseconds)
# -----------------------------------------------------------------------------
# LLM inference typically takes 5-30s. 5000 is too short for most providers.
# Default if unset: 5000
OPENAI_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# OPTIONAL: Web server port (only used by `pnpm web`)
# -----------------------------------------------------------------------------
# Default if unset: 3000
# PORT=3000